---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { getDict, type Locale } from '../i18n';
import { formatNumber, formatYear } from '../lib/format';
import type { GithubProfile, GithubStats } from '../lib/github/types';

interface Props {
  lang: Locale;
  profile: GithubProfile | null;
  stats: GithubStats | null;
}

const { lang, profile, stats } = Astro.props;
const t = getDict(lang);

const statsList = [
  {
    value: stats ? formatNumber(stats.publicRepos, lang) : '—',
    label: t.about.stats.repos,
  },
  {
    value: profile ? formatYear(profile.created_at, lang) : '—',
    label: t.about.stats.since,
  },
  {
    value: stats ? formatNumber(Object.keys(stats.languages).length, lang) : '—',
    label: t.about.stats.langs,
  },
];
---

<Section id="about">
  <SectionHeading index={t.about.index} title={t.about.title} />

  <div class="mt-12 grid gap-10 lg:grid-cols-[1.15fr_0.85fr]">
    <div class="reveal">
      <p class="text-[clamp(1.25rem,2.4vw,1.7rem)] font-medium leading-snug text-ink text-balance">
        {t.about.lead}
      </p>
      <div class="mt-7 flex flex-col gap-4 text-[0.98rem] leading-relaxed text-dim">
        <p>{t.about.p1}</p>
        <p>{t.about.p2}</p>
        <p class="mono text-[0.9rem] text-ink">
          <span class="text-accent">→</span> {t.about.p3}
        </p>
      </div>
    </div>

    <div class="grid gap-3 reveal" style="--reveal-delay:120ms">
      {
        statsList.map((s) => (
          <div class="glass glass-hover flex items-baseline justify-between gap-4 p-5">
            <span class="mono text-3xl font-medium text-ink">{s.value}</span>
            <span class="label-dim text-right">{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</Section>
