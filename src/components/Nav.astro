---
import { getDict, switchLocaleUrl, type Locale } from '../i18n';
import { SITE } from '../data/site';
import { baseFromPath } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDict(lang);

const path = Astro.url.pathname;
const base = baseFromPath(path, lang);
const isHome = base === '/' || base === '/';

/** On the home page anchors scroll in place; elsewhere they return home. */
const link = (hash: string) => (isHome ? hash : `${lang === 'ru' ? '/ru/' : '/'}${hash}`);

const items = [
  { href: link('#about'), label: t.nav.about },
  { href: link('#skills'), label: t.nav.skills },
  { href: link('#projects'), label: t.nav.projects },
  { href: link('#github'), label: t.nav.github },
  { href: link('#journey'), label: t.nav.journey },
  { href: link('#services'), label: t.nav.services },
  { href: link('#writing'), label: t.nav.writing },
  { href: link('#contact'), label: t.nav.contact },
];

const switchUrl = switchLocaleUrl(path, lang);
const blogHome = isHome ? (lang === 'ru' ? '/ru/blog/' : '/blog/') : link('#writing');
---

<header id="site-nav" class="nav-shell fixed inset-x-0 top-0 z-50">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-5">
    <a href={lang === 'ru' ? '/ru/' : '/'} class="mono flex items-center gap-1 text-[0.9rem] font-medium">
      <span class="text-accent">~/</span><span class="text-ink">jengas</span
      ><span class="caret ml-0.5 h-3 w-1.5" aria-hidden="true"></span>
    </a>

    <nav class="hidden items-center gap-5 lg:flex" aria-label={t.nav.menu}>
      {
        items.map((item) => (
          <a href={item.href} class="text-[0.82rem] text-dim transition-colors hover:text-accent">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href={blogHome} class="icon-btn hidden sm:inline-flex" aria-label={t.nav.blog} title={t.nav.blog}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
        </svg>
      </a>

      <a
        href={SITE.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="icon-btn"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7 0-.7 0-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z" />
        </svg>
      </a>

      <a
        href={switchUrl}
        class="mono rounded-full border border-line px-3 py-1.5 text-[0.68rem] tracking-wider text-dim transition-colors hover:border-accent hover:text-accent"
        aria-label={t.nav.language}
        title={t.nav.language}
      >
        {lang === 'en' ? 'RU' : 'EN'}
      </a>

      <button
        type="button"
        id="theme-toggle"
        class="icon-btn"
        aria-label={t.nav.theme}
        title={t.nav.theme}
      >
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <button
        type="button"
        id="nav-toggle"
        class="icon-btn lg:hidden"
        aria-label={t.nav.menu}
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" />
        </svg>
      </button>
    </div>
  </div>

  <div id="nav-menu" class="nav-menu hidden border-t border-line px-5 pb-5 pt-2 lg:hidden">
    <nav class="flex flex-col gap-1" aria-label={t.nav.menu}>
      {
        items.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-3 py-2.5 text-sm text-dim transition-colors hover:bg-glass hover:text-accent"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .nav-shell {
    background: transparent;
    transition:
      background-color 0.3s ease,
      backdrop-filter 0.3s ease,
      border-color 0.3s ease;
    border-bottom: 1px solid transparent;
  }

  .nav-shell[data-scrolled='true'] {
    background: var(--c-glass);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    border-bottom-color: var(--c-line);
  }

  .nav-menu[data-open='true'] {
    display: block;
    background: var(--c-bg);
  }

  /* Icon visibility follows the active theme. */
  #site-nav .icon-sun {
    display: none;
  }
  :global([data-theme='light']) #site-nav .icon-sun {
    display: block;
  }
  :global([data-theme='light']) #site-nav .icon-moon {
    display: none;
  }
</style>

<script>
  const shell = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const themeBtn = document.getElementById('theme-toggle');

  const onScroll = () => {
    shell?.setAttribute('data-scrolled', String(window.scrollY > 12));
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = menu?.getAttribute('data-open') !== 'true';
    menu?.setAttribute('data-open', String(open));
    toggle.setAttribute('aria-expanded', String(open));
  });

  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.setAttribute('data-open', 'false');
      toggle?.setAttribute('aria-expanded', 'false');
    }),
  );

  themeBtn?.addEventListener('click', () => {
    const current = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = current;
    try {
      localStorage.setItem('theme', current);
    } catch {
      /* storage disabled */
    }
  });
</script>
