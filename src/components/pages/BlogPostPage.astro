---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDict, type Locale } from '../../i18n';
import { formatDate, fill, readingTime } from '../../lib/format';
import { getPosts, postSlug, postUrl, hasTranslation } from '../../lib/blog';
import { render } from 'astro:content';

interface Props {
  lang: Locale;
  slug: string;
}

const { lang, slug } = Astro.props;
const t = getDict(lang);

const posts = await getPosts(lang);
const entry = posts.find((p) => postSlug(p) === slug);

if (!entry) {
  // getStaticPaths only passes real slugs, so this is a safety net.
  throw new Error(`Blog post not found: ${lang}/${slug}`);
}

const { Content } = await render(entry);
const minutes = readingTime(entry.body ?? '');
const translation = await hasTranslation(slug, lang);
const otherUrl = postUrl(lang === 'en' ? 'ru' : 'en', slug);
const blogHome = lang === 'ru' ? '/ru/blog/' : '/blog/';
const home = lang === 'ru' ? '/ru/' : '/';
---

<BaseLayout
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  ogType="article"
>
  <article class="mx-auto max-w-3xl px-5 pb-24 pt-32 md:pt-40">
    <a href={blogHome} class="mono text-sm text-dim transition-colors hover:text-accent">
      ← {t.writing.blogTitle}
    </a>

    <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2">
      <span class="label">{formatDate(entry.data.pubDate.toISOString(), lang)}</span>
      <span class="label-dim">{fill(t.writing.minRead, { n: minutes })}</span>
    </div>

    <h1 class="display mt-5 text-[clamp(2.1rem,5.5vw,3.4rem)]">
      {entry.data.title}
    </h1>

    <p class="mt-5 text-lg leading-relaxed text-dim">{entry.data.description}</p>

    <div class="mt-6 flex flex-wrap gap-2">
      {entry.data.tags.map((tag) => <span class="chip">#{tag}</span>)}
    </div>

    <div class="rule my-10"></div>

    <div class="prose-terminal">
      <Content />
    </div>

    <div class="rule my-12"></div>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <a href={home} class="btn btn-ghost btn-sm">← {t.writing.backToHome}</a>
      {
        translation && (
          <a href={otherUrl} class="mono text-sm text-dim transition-colors hover:text-accent">
            {lang === 'en' ? 'Читать по-русски →' : 'Read in English →'}
          </a>
        )
      }
    </div>
  </article>
</BaseLayout>
