---
import Section from './Section.astro';
import SectionHeading from './SectionHeading.astro';
import { getDict, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getDict(lang);
---

<Section id="services">
  <SectionHeading index={t.services.index} title={t.services.title} subtitle={t.services.subtitle} />

  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      t.services.items.map((item, i) => (
        <article class="glass glass-hover group flex flex-col p-6 reveal" style={`--reveal-delay:${(i % 3) * 80}ms`}>
          <span class="mono text-xs text-faint transition-colors group-hover:text-accent">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-3 text-base font-medium text-ink">{item.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-dim">{item.desc}</p>
        </article>
      ))
    }
  </div>
</Section>
