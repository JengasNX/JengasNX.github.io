# ---------------------------------------------------------------------------
# Build-time environment (read by Astro while building — NEVER shipped to the
# browser; only PUBLIC_* variables are exposed to client scripts).
# ---------------------------------------------------------------------------

# Whose GitHub repositories are shown on the site.
GITHUB_USERNAME=JengasNX

# Optional. Raises the build-time GitHub API limit from 60 to 1000+ req/h.
# Add it as a repository/organization secret in CI — never commit a real token.
GITHUB_TOKEN=

# Endpoint for the contact form (serverless backend). When empty the form
# honestly tells the visitor that sending is not connected yet.
# Example: https://example.com/api/contact
PUBLIC_CONTACT_ENDPOINT=
