# ---------------------------------------------------------------------------
# Frontend environment (VITE_* — встроены в сборку, НЕ ХРАНЯТ секретов)
# ---------------------------------------------------------------------------
# Публичный username GitHub, чьи репозитории отображаются в портфолио.
VITE_GITHUB_USERNAME=JengasAdmin

# Base path сборки (для репозитория-профиля оставьте "/", для проектного
# репозитория укажите "/<repo-name>/").
VITE_BASE_PATH=/

# Опционально: endpoint контактной формы (serverless/ backend).
# Если не задан — форма явно сообщает, что отправка ещё не подключена.
# Пример: VITE_CONTACT_ENDPOINT=https://example.com/api/contact
VITE_CONTACT_ENDPOINT=

# ---------------------------------------------------------------------------
# ВАЖНО про безопасность
# ---------------------------------------------------------------------------
# НИКОГДА не добавляйте сюда GitHub Personal Access Token, API-ключи,
# приватные ключи или пароли — переменные VITE_* попадают в клиентский бандл.
# GitHub REST API для публичных данных работает без авторизации (60 req/h).
# Если потребуется больше — создайте serverless-прокси, который держит токен
# на сервере (пример: /api/github-proxy с GITHUB_TOKEN в environment variables).
